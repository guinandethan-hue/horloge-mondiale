{
  "name": "horloge-mondiale",
  "productName": "Horloge mondiale",
  "version": "1.1.0",
  "private": true,
  "description": "Horloge mondiale hors ligne avec carte interactive, fuseaux horaires, favoris et export CSV",
  "author": "Ethan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.User.horlogemondiale",
    "productName": "Horloge mondiale",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "leaflet.js",
      "leaflet.css",
      "countries.geo.js",
      "timezones.geo.js",
      "PDP.ico",
      "images/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "PDP.ico"
    },
    "nsis": {
      "artifactName": "Horloge-mondiale-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Horloge mondiale",
      "installerIcon": "PDP.ico",
      "uninstallerIcon": "PDP.ico"
    }
  }
}
