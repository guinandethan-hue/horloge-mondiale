{
  "name": "horloge-mondiale",
  "productName": "Horloge mondiale",
  "version": "1.0.0",
  "description": "Carte mondiale des fuseaux horaires",
  "author": "User",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "fr.User.horlogemondiale",
    "productName": "Horloge mondiale",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "leaflet.js",
      "leaflet.css",
      "countries.geo.js",
      "timezones.geo.js",
      "PDP.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "PDP.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "PDP.ico",
      "uninstallerIcon": "PDP.ico"
    }
  }
}
